Package: lab4advr
Type: Package
Title: A linear regression package in R 
Version: 0.1.0
Authors@R: c(
    person(
      "Wenjuan Li", "QianWen Yu",
      email = "wenli420@student.liu.se",
      role = c("aut", "cre")
    )
